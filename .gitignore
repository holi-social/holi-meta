# Ignore macOS system files
.DS_Store

# all subdirectories that start with holi (git checkouts)
/holi-*/
app.gitlab-pages.holi.team/

# secret GCP key file for terraform should not be committed
.holi-terraform.key

.venv

# don't commit .envrc.local
.envrc.local
.envrc.local.backends

.idea
/.gitlab-ci-local

# Ignore local configuration files
/compose/*/.env
/compose/pg/migration.sql