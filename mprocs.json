{
  "procs": {
    "web": {
      "shell": "yarn web:dev",
      "env": {
        "HOLI_API_URL" : "https://staging.unified.apis.project-holi.org/graphql"
      },
      "cwd": "<CONFIG_DIR>/holi-frontends"
    },
    "mobile": {
      "shell": "yarn mobile:dev",
      "env": {
        "HOLI_API_URL" : "https://staging.unified.apis.project-holi.org/graphql"
      },
      "cwd": "<CONFIG_DIR>/holi-frontends"
    },
    "storybook": {
      "shell": "yarn storybook:dev --no-open",
      "cwd": "<CONFIG_DIR>/holi-frontends"
    },
    "continuous-tests": {
      "shell": "while true; do sleep 1; done # needs work, we don't have unit test yet cd holi-frontends; jest -w",
      "env": {
        "NODE_ENV": "test"
      }
    }
  }
}
